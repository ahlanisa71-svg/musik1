<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_glass_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <FrameLayout
        android:layout_width="96dp"
        android:layout_height="86dp">

        <ImageView
            android:layout_width="82dp"
            android:layout_height="82dp"
            android:layout_gravity="center_vertical"
            android:contentDescription="@null"
            android:src="@drawable/widget_vinyl" />

        <ImageView
            android:id="@+id/w_cover"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="21dp"
            android:layout_marginTop="23dp"
            android:background="@drawable/widget_cover_circle"
            android:clipToOutline="true"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_w_music" />

        <ImageView
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginStart="37dp"
            android:layout_marginTop="39dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_hole" />

        <ImageView
            android:layout_width="34dp"
            android:layout_height="48dp"
            android:layout_gravity="top|end"
            android:contentDescription="@null"
            android:src="@drawable/ic_w_arm" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/w_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="Musix"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="Ketuk untuk memutar"
            android:textColor="#B3FFFFFF"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/w_prev"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:contentDescription="Sebelumnya"
                android:src="@drawable/ic_w_prev" />

            <ImageButton
                android:id="@+id/w_play"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:contentDescription="Putar/Jeda"
                android:src="@drawable/ic_w_play" />

            <ImageButton
                android:id="@+id/w_next"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:contentDescription="Berikutnya"
                android:src="@drawable/ic_w_next" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
