<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_glass_bg"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="12dp">

    <FrameLayout
        android:layout_width="108dp"
        android:layout_height="92dp">

        <ImageView
            android:layout_width="92dp"
            android:layout_height="92dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_vinyl" />

        <ImageView
            android:id="@+id/w_cover"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="24dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/widget_cover_circle"
            android:clipToOutline="true"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_w_music" />

        <ImageView
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginStart="42dp"
            android:layout_marginTop="42dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_hole" />

        <ImageView
            android:layout_width="34dp"
            android:layout_height="48dp"
            android:layout_gravity="top|end"
            android:contentDescription="@null"
            android:src="@drawable/ic_w_arm" />
    </FrameLayout>

    <TextView
        android:id="@+id/w_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:gravity="center"
        android:singleLine="true"
        android:text="Musix"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/w_artist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:singleLine="true"
        android:text="Ketuk untuk memutar"
        android:textColor="#B3FFFFFF"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/w_prev"
            android:layout_width="40dp"
            android:layout_height="36dp"
            android:background="@android:color/transparent"
            android:contentDescription="Sebelumnya"
            android:src="@drawable/ic_w_prev" />

        <ImageButton
            android:id="@+id/w_play"
            android:layout_width="48dp"
            android:layout_height="36dp"
            android:background="@android:color/transparent"
            android:contentDescription="Putar/Jeda"
            android:src="@drawable/ic_w_play" />

        <ImageButton
            android:id="@+id/w_next"
            android:layout_width="40dp"
            android:layout_height="36dp"
            android:background="@android:color/transparent"
            android:contentDescription="Berikutnya"
            android:src="@drawable/ic_w_next" />
    </LinearLayout>
</LinearLayout>
