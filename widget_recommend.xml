<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_glass_bg"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="12dp">

    <ImageView
        android:id="@+id/w_disc"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:src="@drawable/widget_vinyl" />

    <TextView
        android:id="@+id/w_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:gravity="center"
        android:singleLine="true"
        android:text="Musix"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/w_artist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:singleLine="true"
        android:text="Ketuk untuk memutar"
        android:textColor="#B3FFFFFF"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/w_prev"
            android:layout_width="44dp"
            android:layout_height="36dp"
            android:background="@android:color/transparent"
            android:contentDescription="Sebelumnya"
            android:src="@drawable/ic_w_prev" />

        <ImageButton
            android:id="@+id/w_play"
            android:layout_width="52dp"
            android:layout_height="36dp"
            android:background="@android:color/transparent"
            android:contentDescription="Putar/Jeda"
            android:src="@drawable/ic_w_play" />

        <ImageButton
            android:id="@+id/w_next"
            android:layout_width="44dp"
            android:layout_height="36dp"
            android:background="@android:color/transparent"
            android:contentDescription="Berikutnya"
            android:src="@drawable/ic_w_next" />
    </LinearLayout>
</LinearLayout>
